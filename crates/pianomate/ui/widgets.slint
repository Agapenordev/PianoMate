import { Theme } from "theme.slint";

export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    in property <length> pad: 30px;
    callback clicked;

    height: 46px;
    border-radius: 8px;
    border-width: root.primary ? 0 : 1px;
    border-color: ta.has-hover ? Theme.ink : Theme.faint;
    background: !root.primary ? (ta.has-hover ? Theme.paper-deep : transparent)
        : !root.enabled ? Theme.hairline
        : ta.pressed ? Theme.brass : ta.has-hover ? Theme.brass : Theme.ink;
    animate background, border-color { duration: 120ms; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        Text {
            text: root.text;
            font-size: 15px;
            font-weight: 600;
            color: !root.primary ? Theme.ink : root.enabled ? (ta.has-hover ? #ffffff : Theme.on-ink) : Theme.muted;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// A small clickable text link.
export component Link inherits Rectangle {
    in property <string> text;
    callback clicked;

    width: label.preferred-width;
    height: label.preferred-height;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        font-size: 13px;
        font-weight: 600;
        color: ta.has-hover ? Theme.ink : Theme.brass;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value; // 0 to 1
    in property <color> track: Theme.hairline;
    in property <color> fill: Theme.brass;

    height: 6px;
    border-radius: self.height / 2;
    background: root.track;
    Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.value));
        border-radius: parent.border-radius;
        background: root.fill;
        animate width { duration: 300ms; easing: ease-out; }
    }
}

// A picture cropped to fill a rounded frame.
export component Picture inherits Rectangle {
    in property <image> source;
    in property <ImageFit> fit: cover;

    border-radius: 8px;
    clip: true;
    background: Theme.paper-deep;
    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: root.fit;
    }
}

export component Check inherits Path {
    in property <color> color: Theme.good;

    width: 15px;
    height: 11px;
    commands: "M 1 6 L 5.5 10.5 L 15 1";
    stroke: root.color;
    stroke-width: 2px;
}

// A card surface.
export component Card inherits Rectangle {
    in property <bool> hover;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.hover ? Theme.faint : Theme.hairline;
    background: root.hover ? Theme.raised : Theme.ivory;
    animate background, border-color { duration: 120ms; }
}

export component CheckBox inherits Rectangle {
    in property <bool> checked;
    in property <string> label; // for screen readers
    callback toggled;

    width: 22px;
    height: 22px;
    border-radius: 6px;
    border-width: root.checked ? 0 : 1.5px;
    border-color: ta.has-hover ? Theme.ink : Theme.faint;
    background: root.checked ? Theme.good : transparent;
    animate background { duration: 120ms; }
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-label: root.label;
    accessible-action-default => { root.toggled(); }
    if root.checked: Check {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 9px;
        color: #ffffff;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled;

    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.on ? Theme.brass : Theme.hairline;
    animate background { duration: 150ms; }
    accessible-role: switch;
    accessible-checked: root.on;
    accessible-label: root.label;
    accessible-action-default => { root.toggled(); }
    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// One of a row of mutually exclusive options.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 34px;
    min-width: label.preferred-width + 28px;
    border-radius: 17px;
    border-width: 1px;
    border-color: root.selected ? Theme.ink : ta.has-hover ? Theme.faint : Theme.hairline;
    background: root.selected ? Theme.ink : ta.has-hover ? Theme.paper-deep : transparent;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        font-size: 13px;
        font-weight: root.selected ? 600 : 400;
        color: root.selected ? Theme.on-ink : Theme.ink;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A page inside the shell: scrolls vertically, content in a centred column.
export component Page inherits Rectangle {
    in property <length> column: 820px;

    Flickable {
        content-height: max(self.height, inner.preferred-height + 80px);
        HorizontalLayout {
            alignment: center;
            padding-top: 40px;
            inner := VerticalLayout {
                width: min(root.column, root.width - 72px);
                alignment: start;
                @children
            }
        }
    }
}

export component PageTitle inherits VerticalLayout {
    in property <string> kicker;
    in property <string> title;
    in property <string> subtitle;

    spacing: 6px;
    padding-bottom: 26px;
    if root.kicker != "": Text {
        text: root.kicker;
        font-size: 13px;
        font-weight: 600;
        color: Theme.brass;
    }
    Text {
        text: root.title;
        font-family: Theme.serif;
        font-size: 42px;
        color: Theme.ink;
        wrap: word-wrap;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: 15px;
        color: Theme.muted;
        wrap: word-wrap;
    }
}

export component SectionHead inherits VerticalLayout {
    in property <string> title;
    in property <string> note;

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        padding-bottom: 10px;
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 600;
            color: Theme.ink;
        }
        Text {
            text: root.note;
            font-size: 13px;
            color: Theme.muted;
            horizontal-alignment: right;
        }
    }
    Rectangle {
        height: 1px;
        background: Theme.ink;
        opacity: 0.8;
    }
}

// The back link at the top of a sub-page.
export component Back inherits Rectangle {
    in property <string> text;
    callback clicked;

    height: 30px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 6px;
                height: 11px;
                commands: "M 6 0 L 0 5.5 L 6 11";
                stroke: ta.has-hover ? Theme.ink : Theme.muted;
                stroke-width: 1.6px;
            }
        }
        Text {
            text: root.text;
            font-size: 13px;
            color: ta.has-hover ? Theme.ink : Theme.muted;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
