(
    id: "c02-twinkle-mozart",
    title: "Twinkle, the Mozart Way",
    summary: "The tune Mozart wrote twelve variations on, first plain, then over an Alberti bass.",
    source: "French song \"Ah, vous dirai-je, maman\", theme of Mozart's Variations K. 265 (1781)",
    steps: [
        Explain(
            text: "Mozart took a simple French song, the one we know as Twinkle, Twinkle, and wrote twelve variations on it. Every great arranger starts by knowing the plain tune and its chords perfectly.",
        ),
        Play(
            prompt: "The theme with a simple bass: one note per chord.",
            rh: "C4/1@1 C4 G4@4 G4 | A4@5 A4 G4/2@4 | F4/1@3 F4 E4@2 E4 | D4/1@1 D4 C4/2@1",
            lh: "C3/4@5 | F3/2@2 C3/2@5 | F3/2@2 C3/2@5 | G2/2 C3/2@5",
            beats_per_bar: 4,
            bpm: 80,
            tips: [
                "Finger 4 on G frees finger 5 for the stretch up to A.",
                "The bass changes with the harmony: C, then F and C, then G and C.",
            ],
        ),
        Play(
            prompt: "Now Mozart's texture: the same tune over a rippling Alberti bass.",
            rh: "C4/1@1 C4 G4@4 G4 | A4@5 A4 G4/2@4 | F4/1@3 F4 E4@2 E4 | D4/1@1 D4 C4/2@1",
            lh: "C3/0.5@5 G3@1 E3@3 G3@1 C3 G3 E3 G3 | C3 A3@1 F3@2 A3 C3 G3@1 E3@3 G3 | C3 A3 F3 A3 C3 G3 E3 G3 | B2 G3 F3 G3 C3 G3 E3 G3",
            beats_per_bar: 4,
            bpm: 66,
            tips: [
                "Learn the left hand alone first until it runs by itself.",
                "Melody clearly on top, Alberti bass soft underneath: that balance is the Classical style.",
                "Use In time at 60%, then climb.",
            ],
        ),
    ],
)
