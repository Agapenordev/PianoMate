(
    id: "p04-canon",
    title: "The Canon Progression",
    summary: "Pachelbel's eight chords: the sequence under countless J-pop and anime songs.",
    source: "Johann Pachelbel, Canon in D (c. 1680), here in C major",
    steps: [
        Explain(
            text: "Pachelbel's Canon repeats eight chords over and over: I, V, vi, iii, IV, I, IV, V. Songwriters have borrowed the sequence ever since; in Japanese pop it is so common it has its own nickname, the Canon progression.",
            show: Keys((from: "C2", to: "C3", marks: [("C2", "I"), ("E2", "iii"), ("F2", "IV"), ("G2", "V"), ("A2", "vi"), ("C3", "I")])),
        ),
        Play(
            prompt: "The bass line alone, one note per chord: C, G, A, E, F, C, F, G.",
            lh: "C3/2@1 G2 | A2 E2 | F2 C2 | F2 G2",
            beats_per_bar: 4,
            bpm: 66,
            tips: [
                "Each bass note lasts two beats: let it ring for its full length.",
                "The jumps are wide: look at the next note while the current one is still sounding.",
            ],
        ),
        Quiz(
            question: "In the Canon, which chord follows vi (A minor)?",
            choices: ["iii (E minor)", "V (G)", "IV (F)"],
            answer: 0,
        ),
        Play(
            prompt: "The famous melody above it: a slow scale walking down, then turning up at the end.",
            rh: "E5/2@5 D5@4 | C5@3 B4@2 | A4@1 G4@1 | A4@2 B4@3",
            beats_per_bar: 4,
            bpm: 66,
            tips: [
                "Play it as one long singing line: connect each note to the next.",
                "The thumb takes A, then shifts down to G: move it smoothly, without a gap.",
            ],
        ),
        Play(
            prompt: "Melody and bass together. Listen first.",
            rh: "E5/2@5 D5@4 | C5@3 B4@2 | A4@1 G4@1 | A4@2 B4@3",
            lh: "C3/2@1 G2 | A2 E2 | F2 C2 | F2 G2",
            beats_per_bar: 4,
            bpm: 60,
            tips: [
                "The melody sings, the bass supports: two volumes at once.",
                "Hands separately until both feel easy, then together at 60%.",
            ],
        ),
        Explain(
            text: "Now fill in the harmony. Each chord sits close to the last, so the right hand barely moves: arrangers call this smooth voice leading.",
            show: Music("E4+G4+C5/2 D4+G4+B4/2 | E4+A4+C5/2 E4+G4+B4/2", "C3/2 G2 | A2 E2"),
        ),
        Play(
            prompt: "Full Canon progression: block chords in the right hand over the bass.",
            rh: "E4+G4+C5/2@1+2+5 D4+G4+B4/2@1+3+5 | E4+A4+C5/2@1+3+5 E4+G4+B4/2@1+2+5 | F4+A4+C5/2@1+3+5 E4+G4+C5/2@1+2+5 | F4+A4+C5/2@1+3+5 D4+G4+B4/2@1+3+5",
            lh: "C3/2@1 G2 | A2 E2 | F2 C2 | F2 G2",
            beats_per_bar: 4,
            bpm: 60,
            tips: [
                "Find which notes stay the same between chords: those fingers do not move.",
                "This is the backbone of a solo arrangement: put any melody from a Canon-progression song on top.",
            ],
        ),
    ],
)
