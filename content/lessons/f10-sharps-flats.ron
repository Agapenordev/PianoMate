(
    id: "f10-sharps-flats",
    title: "Sharps, Flats and Half Steps",
    summary: "The black keys get names, and the step pattern behind every major five-finger scale.",
    steps: [
        Explain(
            text: "A half step is the very next key, black or white. A whole step skips one key.",
            show: Keys((from: "C4", to: "G4", marks: [("C4", "C"), ("C#4", "C♯"), ("D4", "D")], arcs: [("C4", "C#4", "half"), ("C4", "D4", "whole")])),
        ),
        Explain(
            text: "A sharp ♯ raises a note a half step. A flat ♭ lowers it a half step. One black key has two names.",
            show: Keys((from: "C4", to: "E4", marks: [("C#4", "C♯ / D♭")], arcs: [("C4", "C#4", "♯ up"), ("D4", "C#4", "♭ down")])),
        ),
        Find(
            prompt: "Find F sharp and B flat.",
            keys: ["F#4", "A#4"],
            show: Music("F#4/2 Bb4/2", ""),
        ),
        Quiz(
            question: "E to F, with no black key between them, is a...",
            show: Keys((from: "C4", to: "G4", marks: [("E4", "E"), ("F4", "F")])),
            choices: ["Half step", "Whole step"],
            answer: 0,
        ),
        Explain(
            text: "Every major pentascale has the same pattern: whole, whole, half, whole. Start anywhere and follow it.",
            show: Keys((from: "D4", to: "A4", marks: [("D4", "D"), ("E4", "E"), ("F#4", "F♯"), ("G4", "G"), ("A4", "A")], arcs: [("D4", "E4", "W"), ("E4", "F#4", "W"), ("F#4", "G4", "H"), ("G4", "A4", "W")])),
        ),
        Play(
            prompt: "The D major pentascale. Finger 3 plays a black key.",
            rh: "D4/1@1 E4@2 F#4@3 G4@4 | A4/2@5 F#4/1@3 D4@1",
            beats_per_bar: 4,
            names: true,
            tips: [
                "Finger 3 plays F sharp: let the hand sit a little further into the keys.",
                "Listen: the black key should not sound louder than the white ones.",
            ],
        ),
        Play(
            prompt: "Ode to Joy, transposed to D.",
            rh: "F#4/1@3 F#4 G4@4 A4@5 | A4 G4 F#4 E4@2 | D4@1 D4 E4 F#4 | F#4/1.5 E4/0.5 E4/2",
            beats_per_bar: 4,
            tips: [
                "The same melody, a step higher: your ear tells you if a note is wrong.",
                "Finger 3 stays ready over F sharp the whole time.",
            ],
        ),
    ],
)
