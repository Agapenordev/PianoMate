(
    id: "v03-broken-octaves",
    title: "Broken Octaves and Rotation",
    summary: "Rock between thumb and little finger: the engine of driving bass lines and shimmering melodies.",
    steps: [
        Explain(
            text: "Broken octaves alternate the thumb and little finger. The power comes from turning the forearm, like turning a doorknob, not from the fingers lifting.",
            show: Keys((from: "C4", to: "C5", marks: [("C4", "1"), ("C5", "5")], arcs: [("C4", "C5", "rotate")])),
        ),
        Play(
            prompt: "Right hand: rock between C and the C above, then walk up the scale.",
            rh: "C4/0.5@1 C5@5 C4@1 C5@5 D4@1 D5@5 D4@1 D5@5 | E4@1 E5@5 E4@1 E5@5 C4/2@1",
            beats_per_bar: 4,
            bpm: 60,
            tips: [
                "Keep the 1–5 span fixed and let the forearm rotate from side to side.",
                "Stay close to the keys: the less the hand lifts, the faster it can go.",
                "Stop the moment you feel strain in the forearm, shake it out, and continue slower.",
            ],
        ),
        Explain(
            text: "In the left hand, broken octaves make the rolling bass behind energetic arrangements: low note, octave, low note, octave, changing with the harmony.",
            show: Keys((from: "C2", to: "C3", marks: [("C2", "5"), ("C3", "1")], arcs: [("C2", "C3", "rotate")])),
        ),
        Play(
            prompt: "Rolling bass on C, G, A and F: the four chords of pop, driven by broken octaves.",
            lh: "C2/0.5@5 C3@1 C2@5 C3@1 G1@5 G2@1 G1@5 G2@1 | A1@5 A2@1 A1@5 A2@1 F1@5 F2@1 F1@5 F2@1",
            beats_per_bar: 4,
            bpm: 72,
            tips: [
                "The low note (finger 5) gets a little more weight; the octave above is lighter.",
                "Move to each new root during the last note before it, so the change lands on time.",
                "Practise at 60% in In time until it is effortless, then climb.",
            ],
        ),
        Play(
            prompt: "A melody over it. Hands separately first, then together.",
            rh: "E5/2@3 G5/2@5 | C5/2@1 A4/2@1",
            lh: "C2/0.5@5 C3@1 C2@5 C3@1 G1@5 G2@1 G1@5 G2@1 | A1@5 A2@1 A1@5 A2@1 F1@5 F2@1 F1@5 F2@1",
            beats_per_bar: 4,
            bpm: 66,
            tips: [
                "The rolling bass must be automatic before the melody joins.",
                "Melody in long notes, sung over the busy left hand.",
            ],
        ),
    ],
)
