// The curriculum: goals are roads made of stages; stages draw on real, public-domain books.
// A stage with no lessons yet is shown as "in preparation".
(
    books: [
        (
            id: "hanon",
            title: "The Virtuoso Pianist in 60 Exercises",
            author: "Charles-Louis Hanon",
            year: 1873,
            image: "hanon.jpg",
            blurb: "Sixty patterns for independence, evenness and speed, then scales, arpeggios, repeated notes, trills and octaves. The daily warm-up of conservatories for a century and a half.",
        ),
        (
            id: "czerny",
            title: "Practical Method for Beginners, Op. 599, and The School of Velocity, Op. 299",
            author: "Carl Czerny",
            year: 1839,
            image: "czerny.jpg",
            blurb: "Beethoven's pupil and Liszt's teacher wrote the studies that turn finger exercises into music: short pieces that each drill one difficulty at rising speed.",
        ),
        (
            id: "notebook",
            title: "Notebook for Anna Magdalena Bach",
            author: "Johann Sebastian Bach and his circle",
            year: 1725,
            image: "bach.jpg",
            blurb: "The Bach family's own teaching album: minuets, marches and chorales that teach two independent hands and a singing line.",
        ),
        (
            id: "beethoven",
            title: "Symphony No. 9 and the Bagatelles",
            author: "Ludwig van Beethoven",
            year: 1824,
            image: "beethoven.jpg",
            blurb: "Melodies everyone already knows by ear, which makes them the best first music to read: you hear at once when a note is wrong.",
        ),
        (
            id: "burgmuller",
            title: "25 Easy and Progressive Studies, Op. 100",
            author: "Friedrich Burgmüller",
            year: 1852,
            image: "burgmuller.jpg",
            blurb: "Character pieces with names like Arabesque and Ballade. Each teaches a touch or a texture inside real music, with melody and accompaniment in both hands.",
        ),
        (
            id: "clementi",
            title: "Six Sonatinas, Op. 36",
            author: "Muzio Clementi",
            year: 1797,
            image: "clementi.jpg",
            blurb: "The classic bridge from studies to sonatas: scales, broken chords and phrasing at full tempo, in complete three-movement works.",
        ),
        (
            id: "chopin",
            title: "Études, Op. 10 and Op. 25",
            author: "Frédéric Chopin",
            year: 1833,
            image: "chopin.jpg",
            blurb: "The summit of piano technique: wide arpeggios, double notes, octaves and leaps, written as concert music. This is the vocabulary virtuoso arrangements are built from.",
        ),
    ],
    stages: [
        (
            id: "first-touch",
            title: "First Touch",
            blurb: "Sit well, number your fingers, find your way around the keys, count the four basic note values, and play your first melody under five fingers.",
            image: "renoir.jpg",
            emblem: "hand",
            part: "Foundations",
            lessons: ["f01-hands-and-keys", "b01-middle-c", "f01-note-values", "f01-c-pentascale", "m01-ode-to-joy"],
        ),
        (
            id: "grand-staff",
            title: "Reading the Grand Staff",
            blurb: "Lines and spaces, the two clefs, Middle C between them, and counting in 4/4 and 3/4.",
            image: "bach.jpg",
            emblem: "treble",
            part: "Foundations",
            lessons: ["f02-grand-staff", "b02-c-d-e"],
        ),
        (
            id: "landmarks",
            title: "Clef Landmarks",
            blurb: "Use the clefs themselves as signposts, and read quickly in Middle C position.",
            image: "beethoven.jpg",
            emblem: "bass",
            part: "Foundations",
            lessons: ["f03-landmarks", "rv1-middle-c-reading"],
        ),
        (
            id: "skips-rests",
            title: "Skips, Rests and the C Chord",
            blurb: "Spot 3rds at a glance, count silence, and put a chord under a melody.",
            image: "gachet.jpg",
            emblem: "rest",
            part: "Foundations",
            lessons: ["f04-thirds-rests-c-chord"],
        ),
        (
            id: "bass-staccato",
            title: "The Bass Clef and Staccato",
            blurb: "Read C, D and E low in the bass, and play short, bouncing notes.",
            image: "renoir.jpg",
            emblem: "staccato",
            part: "Foundations",
            lessons: ["f05-bass-c-staccato", "b03-bass-clef", "rv2-bass-reading"],
        ),
        (
            id: "eighths",
            title: "Eighth Notes and Upbeats",
            blurb: "Two notes to a beat, tunes that start before the bar, and a chord that leans and resolves.",
            image: "bach.jpg",
            emblem: "eighths",
            part: "Foundations",
            lessons: ["f06-eighths-upbeats", "b04-keeping-the-beat"],
        ),
        (
            id: "face",
            title: "Spaces, F Chord and Arpeggios",
            blurb: "F-A-C-E in the treble spaces, the F chord, and an arpeggio across both hands.",
            image: "beethoven.jpg",
            emblem: "chord",
            part: "Foundations",
            lessons: ["f07-face", "rv3-treble-reading"],
        ),
        (
            id: "treble-c",
            title: "Moving Up: Treble C",
            blurb: "Shift the right hand up an octave and read high on the staff.",
            image: "gachet.jpg",
            emblem: "treble",
            part: "Foundations",
            lessons: ["f08-treble-c", "rv4-high-reading"],
        ),
        (
            id: "g-position",
            title: "G Position and the G Chord",
            blurb: "A new home for both hands, the G chord, and the bright Gsus4.",
            image: "renoir.jpg",
            emblem: "quarter",
            part: "Foundations",
            lessons: ["f09-g-position"],
        ),
        (
            id: "sharps-flats",
            title: "Sharps, Flats and Half Steps",
            blurb: "The black keys get names: half steps, whole steps, and the pattern behind every major five-finger scale.",
            image: "bach.jpg",
            emblem: "sharp",
            part: "Foundations",
            lessons: ["f10-sharps-flats"],
        ),
        (
            id: "wide-intervals",
            title: "Wider Intervals",
            blurb: "4ths, 5ths and 6ths, broken and blocked: reading by shape instead of by name.",
            image: "beethoven.jpg",
            emblem: "fermata",
            part: "Foundations",
            lessons: ["f11-wide-intervals"],
        ),
        (
            id: "c-scale",
            title: "The C Major Scale",
            blurb: "Eight notes with five fingers: the thumb crossing that every fast run depends on.",
            image: "gachet.jpg",
            emblem: "flat",
            part: "Foundations",
            lessons: ["t03-c-major-scale"],
        ),
        (
            id: "g7",
            title: "The G7 Chord",
            blurb: "The chord that pulls home: G7 and its resolution to C.",
            image: "renoir.jpg",
            emblem: "chord",
            part: "Foundations",
            lessons: ["f13-g7"],
        ),
        (
            id: "chords-c",
            title: "Primary Chords in C",
            blurb: "I, IV and V7: the three chords behind countless songs, and how to read them from a lead sheet.",
            image: "bach.jpg",
            emblem: "forte",
            part: "Foundations",
            lessons: ["f14-primary-c"],
        ),
        (
            id: "g-scale",
            title: "The G Major Scale",
            blurb: "A scale with one sharp, its key signature, and a minuet from the Bach family notebook.",
            image: "beethoven.jpg",
            emblem: "sharp",
            part: "Foundations",
            lessons: ["f15-g-scale", "m02-minuet-in-g"],
        ),
        (
            id: "chords-g",
            title: "Primary Chords in G",
            blurb: "I, IV and V7 in G with the D7 chord, then a whole song from chord symbols.",
            image: "gachet.jpg",
            emblem: "forte",
            part: "Foundations",
            lessons: ["f16-primary-g"],
        ),
        (
            id: "minor-keys",
            title: "Minor Keys",
            blurb: "A minor, the relative minor of C: the darker home behind most anime and film themes.",
            image: "chopin.jpg",
            emblem: "flat",
            part: "Foundations",
            lessons: ["f17-a-minor"],
        ),
        (
            id: "finger-independence",
            part: "Technique",
            title: "Finger Independence",
            blurb: "Hanon's opening exercises: equal strength and evenness in all ten fingers, the foundation of every fast passage.",
            image: "hanon.jpg",
            books: ["hanon"],
            lessons: ["t01-hanon-1", "t02-hanon-2-3"],
        ),
        (
            id: "scales",
            part: "Technique",
            title: "Scales and the Travelling Thumb",
            blurb: "The thumb-under movement and the major scales, from Part II of Hanon. Runs and glittering passagework start here.",
            image: "hanon.jpg",
            books: ["hanon"],
            lessons: ["t04-more-scales"],
        ),
        (
            id: "first-classics",
            part: "Repertoire",
            title: "First Classics",
            blurb: "Pieces you know by ear, learned properly: Für Elise, then Clementi's sonatinas.",
            image: "beethoven.jpg",
            books: ["beethoven", "clementi"],
            lessons: ["c01-fur-elise", "c02-twinkle-mozart"],
        ),
        (
            id: "hands-together",
            part: "Repertoire",
            title: "Both Hands Together",
            blurb: "Melody in one hand, accompaniment in the other, with Burgmüller's studies and the two-part pieces of the Bach notebook.",
            image: "burgmuller.jpg",
            books: ["burgmuller", "notebook"],
            lessons: ["r01-hands-independence"],
        ),
        (
            id: "velocity",
            part: "Technique",
            title: "Velocity",
            blurb: "Czerny's studies, from Op. 599 to The School of Velocity: clean passagework at rising metronome marks.",
            image: "czerny.jpg",
            books: ["czerny"],
            lessons: ["t05-speed-ladder"],
        ),
        (
            id: "chords",
            part: "Arranging",
            title: "Chords and Progressions",
            blurb: "Triads, inversions and the handful of progressions behind almost every anime, film and pop song, in every key.",
            image: "gachet.jpg",
            lessons: ["p01-four-chords", "p02-royal-road", "p04-canon"],
        ),
        (
            id: "left-hand",
            part: "Arranging",
            title: "Left-Hand Textures",
            blurb: "Wide arpeggios, tenths and leaping bass-and-chord patterns: the orchestral left hand that fills out a solo arrangement.",
            image: "czerny.jpg",
            books: ["czerny", "hanon"],
            lessons: ["p03-left-hand-patterns", "p05-alberti-waltz"],
        ),
        (
            id: "octaves",
            part: "Technique",
            title: "Octaves and Leaps",
            blurb: "Wrist octaves, broken octaves and fast jumps, from Part III of Hanon: power and accuracy at full stretch.",
            image: "liszt.jpg",
            books: ["hanon"],
            lessons: ["t06-octaves-leaps"],
        ),
        (
            id: "by-ear",
            part: "Arranging",
            title: "Playing by Ear and Arranging",
            blurb: "Hear a melody and find it, work out its chords, and build your own solo version: tune on top, bass below, harmony in between.",
            image: "wave.jpg",
            lessons: ["e01-by-ear", "e02-by-ear-tunes"],
        ),
        (
            id: "etudes",
            part: "Repertoire",
            title: "Concert Études",
            blurb: "Chopin's études, one difficulty at a time: the last step before the hardest repertoire and transcriptions.",
            image: "chopin.jpg",
            books: ["chopin"],
            lessons: ["v01-arpeggios", "v02-chromatic", "v03-broken-octaves"],
        ),
    ],
    goals: [
        (
            id: "virtuoso",
            title: "Virtuoso Anime and Film Arrangements",
            tagline: "Play big, fast solo arrangements in the style of Animenz.",
            blurb: "Arrangements like these ask for everything at once: a singing melody, a left hand that covers the whole keyboard, octaves, runs and leaps at speed. This road lays the foundations, builds technique in order, then teaches you to arrange by ear.",
            image: "wave.jpg",
            stages: ["first-touch", "grand-staff", "landmarks", "skips-rests", "bass-staccato", "eighths", "face", "treble-c", "g-position", "sharps-flats", "wide-intervals", "c-scale", "g7", "chords-c", "g-scale", "chords-g", "minor-keys", "finger-independence", "scales", "velocity", "octaves", "hands-together", "first-classics", "etudes", "chords", "left-hand", "by-ear"],
        ),
        (
            id: "classical",
            title: "Classical Repertoire",
            tagline: "From first minuets to sonatas and études.",
            blurb: "The traditional conservatory road: solid foundations, sound technique from Hanon and Czerny, then real works of rising difficulty by Bach, Clementi, Beethoven and Chopin.",
            image: "liszt.jpg",
            stages: ["first-touch", "grand-staff", "landmarks", "skips-rests", "bass-staccato", "eighths", "face", "treble-c", "g-position", "sharps-flats", "wide-intervals", "c-scale", "g7", "chords-c", "g-scale", "chords-g", "minor-keys", "finger-independence", "scales", "velocity", "octaves", "first-classics", "hands-together", "etudes"],
        ),
        (
            id: "songs",
            title: "Songs and Accompaniment",
            tagline: "Play the songs you love from chords, and accompany singing.",
            blurb: "The shortest road to music you can share: reading and primary chords first, then chord patterns, left-hand accompaniments, and working songs out by ear.",
            image: "gachet.jpg",
            stages: ["first-touch", "grand-staff", "landmarks", "skips-rests", "bass-staccato", "eighths", "face", "treble-c", "g-position", "sharps-flats", "wide-intervals", "c-scale", "g7", "chords-c", "g-scale", "chords-g", "minor-keys", "hands-together", "chords", "left-hand", "by-ear"],
        ),
        (
            id: "pleasure",
            title: "Read Music and Play for Pleasure",
            tagline: "A calm, steady road to playing real pieces from the page.",
            blurb: "No rush and no heavy drilling: learn to read with both hands, then build a growing shelf of pieces you can sit down and play.",
            image: "renoir.jpg",
            stages: ["first-touch", "grand-staff", "landmarks", "skips-rests", "bass-staccato", "eighths", "face", "treble-c", "g-position", "sharps-flats", "wide-intervals", "c-scale", "g7", "chords-c", "g-scale", "chords-g", "minor-keys", "first-classics", "hands-together", "scales"],
        ),
    ],
)
