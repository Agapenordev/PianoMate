(
    id: "r01-hands-independence",
    title: "Two Hands, Two Jobs",
    summary: "Mirror and parallel motion, then a melody that sings over a moving bass.",
    steps: [
        Explain(
            text: "Contrary motion: the hands move apart like a mirror, same fingers at the same time. It is the easiest way to start playing hands together.",
            show: Keys((from: "F3", to: "G4", marks: [("C4", "1 + 1")], arcs: [("C4", "G4", "right"), ("C4", "F3", "left")])),
        ),
        Play(
            prompt: "Both thumbs on Middle C, then spread out and come back.",
            rh: "C4/1@1 D4@2 E4@3 F4@4 | G4/2@5 E4/1@3 C4@1",
            lh: "C4/1@1 B3@2 A3@3 G3@4 | F3/2@5 A3/1@3 C4@1",
            beats_per_bar: 4,
            bpm: 72,
            tips: [
                "Both hands use the same finger numbers at the same time: easy for the brain.",
                "Listen for both hands landing exactly together.",
            ],
        ),
        Explain(
            text: "Parallel motion: both hands move the same way, an octave apart. The fingers differ, so it is harder: go slowly.",
        ),
        Play(
            prompt: "Parallel, an octave apart: right 1 2 3, left 5 4 3.",
            rh: "C4/1@1 D4@2 E4@3 D4@2 | C4/4@1",
            lh: "C3/1@5 D3@4 E3@3 D3@4 | C3/4@5",
            beats_per_bar: 4,
            bpm: 72,
            tips: [
                "Different fingers in each hand: say the right hand's numbers aloud to stay on track.",
                "Very slowly first; parallel motion is genuinely harder.",
            ],
        ),
        Play(
            prompt: "Ode to Joy over a bass that changes each bar. Let the melody sing, keep the bass soft.",
            rh: "E4/1@3 E4 F4@4 G4@5 | G4 F4@4 E4@3 D4@2 | C4@1 C4 D4 E4 | E4/1.5 D4/0.5 D4/2",
            lh: "C3/4@1 | G2/4@5 | C3/4@1 | G2/2@5 C3/2@1",
            beats_per_bar: 4,
            bpm: 76,
            tips: [
                "Bass soft and long, melody singing: two volumes at once is the core skill of the piano.",
                "Hands separately first. Then together at 60%, then 80%.",
            ],
        ),
    ],
)
