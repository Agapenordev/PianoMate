(
    id: "f02-grand-staff",
    title: "The Grand Staff",
    summary: "Two staves, two clefs, and Middle C between them.",
    steps: [
        Explain(
            text: "Five lines, four spaces. A note sits on a line or in a space.",
            show: Staff(Treble, ["E4", "F4", "G4", "A4", "B4"]),
        ),
        Quiz(
            question: "Line note or space note?",
            show: Staff(Treble, ["G4"]),
            choices: ["Line", "Space"],
            answer: 0,
        ),
        Quiz(
            question: "And this one?",
            show: Staff(Treble, ["A4"]),
            choices: ["Line", "Space"],
            answer: 1,
        ),
        Explain(
            text: "Piano music joins two staves: treble on top for the right hand, bass below for the left.",
            show: Music("G4/4", "F3/4"),
        ),
        Explain(
            text: "Middle C lives between them on a little ledger line. Same key, whichever staff it is written on.",
            show: Music("C4/4", "r/4 C4/4"),
        ),
        Explain(
            text: "Middle C position: both thumbs share C. Right hand goes up, left hand goes down.",
            show: Keys((from: "F3", to: "G4", marks: [("F3", "5"), ("G3", "4"), ("A3", "3"), ("B3", "2"), ("C4", "1"), ("D4", "2"), ("E4", "3"), ("F4", "4"), ("G4", "5")])),
        ),
        Explain(
            text: "The time signature's top number is beats per bar. 4: count 1-2-3-4. 3: count 1-2-3.",
            show: Music("C4/1 D4 E4 | F4/3", ""),
        ),
        Play(
            prompt: "Read each note's staff to know which hand.",
            rh: "C4/1@1 D4@2 E4@3 F4@4 | r/4",
            lh: "r/4 | C4/1@1 B3@2 A3@3 B3@2",
            beats_per_bar: 4,
            names: true,
            tips: [
                "Notes on the top staff are for the right hand, notes on the bottom staff for the left.",
                "Both thumbs share Middle C: only one plays it at a time.",
                "Look ahead to the next note before you play the current one.",
            ],
        ),
        Play(
            prompt: "Now in 3/4, without letters. Connect every note: legato.",
            rh: "E4/1@3 D4@2 C4@1 | r/3 | D4/1@2 E4@3 F4@4 | E4/3@3",
            lh: "r/3 | B3/1@2 A3@3 B3@2 | r/3 | C4/3@1",
            beats_per_bar: 3,
            tips: [
                "Count 1-2-3 in every bar; the first beat is slightly stronger.",
                "Legato: hold each key until the next one sounds, so there is no gap.",
            ],
        ),
    ],
)
